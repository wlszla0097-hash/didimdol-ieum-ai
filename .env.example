# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Vercel에서는 Project → Settings → Environment Variables 에 같은 이름으로 등록합니다.

# AI 키는 둘 중 하나만 있으면 됩니다. (둘 다 있으면 Claude 우선)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 선택: 모델 바꾸기 (기본값 Claude=claude-haiku-4-5-20251001, Gemini=gemini-flash-latest — Google AI Studio에서 쓸 수 있는 모델명으로 바꿀 수 있음)
AI_MODEL=

# 공공데이터포털 일반 인증키(Decoding 키) — 없으면 예시 데이터로 동작
DATA_GO_KR_KEY=

# 선택: 고용24 OpenAPI 인증키 — 채용정보 실시간 연동. 없으면 합성 공고로 동작
#       (엔드포인트는 이용 승인 후 개발명세서로 확인하고, 다르면 WORK24_BASE_URL 로 지정)
WORK24_KEY=
WORK24_BASE_URL=
